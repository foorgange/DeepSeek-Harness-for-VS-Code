{
  "name": "dsh-git-rollback",
  "version": "0.1.7",
  "description": "DSH turn-level Git rollback plugin: /rollback /redo /checkpoints /undo commands, per-turn checkpoints in hidden refs, non-destructive workspace restore, scoped turn undo, checkpoint-SHA restore.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": "./lib/index.js",
    "./src/*": "./src/*"
  },
  "files": [
    "lib",
    "src"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "git",
    "rollback",
    "checkpoint"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/NEXTINDIE/DeepSeek-Harness-for-VS-Code.git"
  },
  "homepage": "https://github.com/NEXTINDIE/DeepSeek-Harness-for-VS-Code",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-session": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-commands": "^0.1.0-rc.6"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test test/rollback-clean.test.mjs",
    "prepublishOnly": "npm run build && npm test"
  }
}
